FROM golang:1.22-alpine AS builder
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-X main.version=${VERSION:-dev} -X main.commit=${COMMIT:-none} -X main.date=$(date -u +%Y-%m-%dT%H:%M:%SZ)" -o /gw-bench ./cmd/gw-bench/

FROM fortio/fortio:1.75.1 AS fortio
FROM grafana/k6:2.0.0 AS k6

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=fortio /usr/bin/fortio /usr/local/bin/fortio
COPY --from=k6 /usr/bin/k6 /usr/local/bin/k6
COPY --from=builder /gw-bench /usr/local/bin/gw-bench
USER 65534:65534
ENTRYPOINT ["gw-bench"]
